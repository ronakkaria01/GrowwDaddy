# cp deploy.env.example deploy.env  then fill this in. deploy.env is gitignored.

# Easiest: an alias from ~/.ssh/config, which already carries the user, port
# and key. You have one called "hostinger", so SSH_HOST=hostinger works once
# that block has the right port.
#
#   Host hostinger
#       HostName 45.130.228.231
#       User u893889857
#       Port 65002              <- shared hosting is not on 22
#       IdentityFile ~/.ssh/hostinger
#
SSH_HOST=hostinger

# Where the site lives on the server. On Hostinger this is usually
# domains/<yourdomain>/public_html. Run `ls domains/*/` over ssh to check.
REMOTE_DIR=domains/growwdaddy.com/public_html

# Only needed if you are NOT using an ~/.ssh/config alias above.
#SSH_USER=u893889857
#SSH_PORT=65002
#SSH_KEY=~/.ssh/hostinger

# Optional. Post-deploy HTTP check. Advisory only, since the domain may be
# proxied through Cloudflare and serve a cached page.
SITE_URL=https://growwdaddy.com
