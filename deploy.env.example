# cp deploy.env.example deploy.env  then fill this in. deploy.env is gitignored.

FTP_HOST=ftp.growwdaddy.com
FTP_USER=your-ftp-user
FTP_PASS=your-ftp-password

# Path relative to the FTP login directory. Often public_html or httpdocs.
# Leave empty if the login already lands in the webroot.
FTP_DIR=public_html

# Optional
FTP_PORT=21
SITE_URL=https://growwdaddy.com    # set this and the script verifies the deploy

# TLS, least bad first. Leave both at 0 if you can.
#
# Cert does not match the host/IP you must connect to ("no alternative
# certificate subject name matches..."). Still encrypted, cert unchecked.
FTP_NO_VERIFY=0
#
# Host has no FTPS at all. Sends your password in clear text.
FTP_INSECURE=0
